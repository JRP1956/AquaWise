# Copy to server/.env and fill in. Never commit the real .env.
PORT=4000

# Local mongod, or an Atlas SRV string: mongodb+srv://user:pass@cluster.mongodb.net/aquawise
MONGODB_URI=mongodb://127.0.0.1:27017/aquawise

# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where the React app runs. In production, the deployed frontend URL.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
